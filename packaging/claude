.KEY args
.BRA {
.KET }
; MOSnode launcher for Claude Code.
; Unpack this archive into ANY drawer on ANY volume, then from that drawer run:
;   execute claude
; Nothing is hardcoded to a "Work:" volume: lib/, home and ksh all resolve via
; PROGDIR: (the drawer the mosnode binary itself lives in), so it works wherever
; you put it. Run it from the drawer you unpacked into.
;
; On first run it downloads Claude Code (cli.js) from npm and compiles it to
; fast-start bytecode, then launches. Later runs start straight away.
IF EXISTS libs
  assign LIBS: libs ADD
ENDIF
setenv MOSNODE_LIB PROGDIR:lib
setenv MOSNODE_HOME PROGDIR:
setenv HOME /PROGDIR
setenv MOSNODE_KSH PROGDIR:bin/ksh
setenv IXPPCSTACK 16777216
stack 16777216
setenv ANTHROPIC_DEFAULT_SONNET_MODEL claude-sonnet-5-5
setenv ANTHROPIC_DEFAULT_HAIKU_MODEL claude-haiku-5-5
setenv MAX_THINKING_TOKENS 0
setenv CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC 1
IF NOT EXISTS cli.qbc
  IF NOT EXISTS cli.js
    echo "Claude Code not found - downloading it from npm (one-time, ~19 MB)..."
    mosnode get-cli.js
  ENDIF
  IF EXISTS cli.js
    echo "Compiling Claude Code to bytecode (one-time, please wait a few minutes)..."
    mosnode --emit-bc cli.qbc cli.js
    echo "Done."
  ELSE
    echo "Could not get Claude Code. Check your internet connection and run"
    echo "'execute claude' again, or copy cli.js in by hand (see README.txt)."
    quit
  ENDIF
ENDIF
mosnode cli.qbc --strict-mcp-config
